{
  "expo": {
    "name": "iSlicer",
    "slug": "bambu-slicer",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ammarjmahmood.islicer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "iSlicer uses the camera to scan the pairing code on your bridge computer.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bambuslicer.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "islicer",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "iSlicer uses the camera to scan the pairing code on your bridge computer.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withPodMinimumTarget"
    ]
  }
}